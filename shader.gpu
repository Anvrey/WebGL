// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 tex;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform mat4 NormalMatrix;
uniform vec2 RotationPoint;
uniform float RotationAngle;

varying vec3 vVertexEye;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTexCoord;

void main() {
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);

    vVertexEye = (ModelViewMatrix * vec4(vertex, 1.0)).xyz;
    vNormal = normalize((NormalMatrix * vec4(normal, 0.0)).xyz);
    vTangent = normalize((ModelViewMatrix * vec4(tangent, 0.0)).xyz);
    vec2 d = tex - RotationPoint;
    float c = cos(RotationAngle);
    float s = sin(RotationAngle);
    vTexCoord = vec2(c * d.x - s * d.y, s * d.x + c * d.y) + RotationPoint;
}`;

// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform sampler2D iTMU0;
uniform sampler2D iTMU1;
uniform sampler2D iTMU2;

uniform vec3 LightPosition;
uniform vec3 AmbientLight;
uniform vec3 DiffuseLight;
uniform vec3 SpecularLight;
uniform float Shininess;
uniform float TexScale;
uniform float RotationAngle;

uniform int UseDiffuse;
uniform int UseSpecular;
uniform int UseNormal;

varying vec3 vVertexEye;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTexCoord;

void main() {
    vec2 uv = vTexCoord * TexScale;

    // Gram-Schmidt orthogonalization (Variant 4: Prioritize normal)
    vec3 N = normalize(vNormal);
    vec3 T = normalize(vTangent - dot(vTangent, N) * N);
    vec3 B = cross(N, T);
    mat3 TBN = mat3(T, B, N);

    // Per-pixel normal from normal texture
    vec3 finalN = N;
    if (UseNormal == 1) {
        vec3 mapN = texture2D(iTMU2, uv).rgb * 2.0 - 1.0;
        float c = cos(RotationAngle);
        float s = sin(RotationAngle);
        mapN.xy = vec2(c * mapN.x + s * mapN.y, c * mapN.y - s * mapN.x);
        finalN = normalize(TBN * mapN);
    }

    vec3 diffTex = (UseDiffuse == 1) ? texture2D(iTMU0, uv).rgb : vec3(0.2, 0.7, 0.9);
    vec3 specTex = (UseSpecular == 1) ? texture2D(iTMU1, uv).rgb : vec3(1.0, 1.0, 1.0);

    vec3 L = normalize(LightPosition - vVertexEye);
    vec3 V = normalize(-vVertexEye);
    vec3 R = reflect(-L, finalN);

    // Ambient
    vec3 ambient = AmbientLight * diffTex;

    // Diffuse modulated by diffuse texture
    float diff = max(dot(finalN, L), 0.0);
    vec3 diffuse = DiffuseLight * diffTex * diff;

    // Specular modulated by specular texture
    float spec = 0.0;
    if (diff > 0.0) {
        spec = pow(max(dot(R, V), 0.0), Shininess);
    }
    vec3 specular = SpecularLight * specTex * spec;

    gl_FragColor = vec4(ambient + diffuse + specular, 1.0);
}`;


// Marker shaders
const markerVertexSource = `
attribute vec3 vertex;
uniform mat4 ModelViewProjectionMatrix;

void main() {
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
    gl_PointSize = 10.0;
}`;

const markerFragmentSource = `
precision mediump float;

void main() {
    gl_FragColor = vec4(1.0, 0.1, 0.1, 1.0);
}`;
